@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix epp: <http://lv2plug.in/ns/ext/port-props#> .
@prefix mod: <http://moddevices.com/ns/mod#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

<http://cyber-audio.co.uk/plugins/cyber-acoustic-feedbacker>
    a lv2:Plugin ,
      lv2:GeneratorPlugin ;
    doap:name "Cyber Acoustic Feedbacker" ;
    doap:license <http://opensource.org/licenses/mit> ;
    doap:developer [
        foaf:name "Cyber Audio" ;
        foaf:homepage <http://cyber-audio.co.uk> ;
    ] ;
    lv2:minorVersion 1 ;
    lv2:microVersion 0 ;
    mod:brand "CyberAudio" ;
    mod:label "Feedbacker" ;
    rdfs:comment "Natural Clean Guitar Harmonic Feedbacker & Polyphonic Sustainer with pitch tracking, root/poly modes, and string resonance bloom." ;

    lv2:port [
        a lv2:AudioPort ,
          lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in_l" ;
        lv2:name "Audio In L" ;
    ] , [
        a lv2:AudioPort ,
          lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "in_r" ;
        lv2:name "Audio In R" ;
    ] , [
        a lv2:AudioPort ,
          lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "out_l" ;
        lv2:name "Audio Out L" ;
    ] , [
        a lv2:AudioPort ,
          lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "out_r" ;
        lv2:name "Audio Out R" ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "bypass" ;
        lv2:name "Bypass" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "mode" ;
        lv2:name "Mode" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 2.0 ;
        lv2:portProperty lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Root Dominant" ; rdf:value 0.0 ] ;
        lv2:scalePoint [ rdfs:label "Poly Sustainer" ; rdf:value 1.0 ] ;
        lv2:scalePoint [ rdfs:label "Harmonic Bloom" ; rdf:value 2.0 ] ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "bloom" ;
        lv2:name "Bloom Time" ;
        lv2:default 40.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "sens" ;
        lv2:name "Sensitivity" ;
        lv2:default 60.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "coupling" ;
        lv2:name "Coupling" ;
        lv2:default 70.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "harmonic" ;
        lv2:name "Harmonic Mode" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 3.0 ;
        lv2:portProperty lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Unison Fundamental" ; rdf:value 0.0 ] ;
        lv2:scalePoint [ rdfs:label "5th Above (+7st)" ; rdf:value 1.0 ] ;
        lv2:scalePoint [ rdfs:label "Octave (+12st)" ; rdf:value 2.0 ] ;
        lv2:scalePoint [ rdfs:label "Natural Dynamic Morph" ; rdf:value 3.0 ] ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 10 ;
        lv2:symbol "warmth" ;
        lv2:name "Warmth" ;
        lv2:default 50.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 11 ;
        lv2:symbol "vibrato" ;
        lv2:name "Vibrato Track" ;
        lv2:default 75.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 12 ;
        lv2:symbol "mix" ;
        lv2:name "Mix" ;
        lv2:default 55.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] .
